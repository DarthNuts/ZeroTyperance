// Resources of ZeroTyperance.exe. build_launcher.sh writes version.inc (ZT_VER_STR, ZT_VER_NUM) beside the build.
#include <winver.h>
#include "version.inc"

1 ICON "zt.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ZT_VER_NUM
PRODUCTVERSION ZT_VER_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "ProductName", "ZeroTyperance"
            VALUE "FileDescription", "ZeroTyperance"
            VALUE "FileVersion", ZT_VER_STR
            VALUE "ProductVersion", ZT_VER_STR
            VALUE "OriginalFilename", "ZeroTyperance.exe"
            VALUE "InternalName", "ZeroTyperance"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
